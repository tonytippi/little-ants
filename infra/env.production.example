# Production settings. Copy to infra/.env.production on the VPS (never commit the real file).
# Replace every <...> value. Hostnames below assume the domain littleants.vn.

NODE_ENV=production

# Database (the postgres service in docker-compose.prod.yml)
POSTGRES_USER=little_ants
POSTGRES_PASSWORD=<long random password>
POSTGRES_DB=little_ants
DATABASE_URL=postgresql://little_ants:<same password>@postgres:5432/little_ants

# Public URLs
API_PUBLIC_URL=https://api.littleants.vn
NEXT_PUBLIC_API_URL=https://api.littleants.vn
NEXT_PUBLIC_TEACHER_APP_URL=https://teacher.littleants.vn
CORS_ORIGINS=https://admin.littleants.vn,https://teacher.littleants.vn

# Sign-in (Better Auth). Generate the secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=<random secret, at least 32 characters>
GOOGLE_CLIENT_ID=<Google OAuth web client id>
GOOGLE_CLIENT_SECRET=<Google OAuth web client secret>
# Share the session cookie between admin., teacher. and api.
AUTH_COOKIE_DOMAIN=.littleants.vn
AUTH_DEV_PASSWORD_LOGIN=false

# Media on Cloudflare R2
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
S3_REGION=auto
# Private bucket: every upload (drafts included). Public bucket: approved files only, behind the media domain.
S3_BUCKET=little-ants-files
S3_PUBLIC_BUCKET=little-ants-media
S3_ACCESS_KEY_ID=<R2 access key id>
S3_SECRET_ACCESS_KEY=<R2 secret access key>
MEDIA_PUBLIC_BASE_URL=https://media.littleants.vn

# Cloudflare Tunnel (Zero Trust → Networks → Tunnels → token)
CLOUDFLARE_TUNNEL_TOKEN=<tunnel token>

# Database backups to R2 (a separate bucket is recommended)
BACKUP_BUCKET=little-ants-backups
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR_UTC=19
