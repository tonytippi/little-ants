# Production settings for infra/docker-compose.prod.yml. Copy to .env.production at the repository
# root on the server (never commit the real file). Replace every <...> value.
#
# The compose file sets NODE_ENV, DATABASE_URL, API_PUBLIC_URL, CORS_ORIGINS and the NEXT_PUBLIC_* URLs
# itself, from the values below, so they are not listed here.

# Database (the postgres service; reachable from the host on 127.0.0.1:9203)
POSTGRES_USER=little_ants
# URL-safe, e.g. openssl rand -hex 32 (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=<long random password>
POSTGRES_DB=little_ants

# Public hostnames served through Cloudflare Tunnel (these are the defaults).
ADMIN_HOST=admin.littleantsenglish.com
TEACHER_HOST=teacher.littleantsenglish.com
API_HOST=api.littleantsenglish.com
STUDENT_HOST=littleantsenglish.com
# Share the staff session cookie between admin., teacher., the root (student) and api. Every littleantsenglish.com
# site receives this cookie, so only host trusted apps on that domain.
AUTH_COOKIE_DOMAIN=.littleantsenglish.com

# Sign-in (Better Auth). Generate the secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=<random secret, at least 32 characters>
GOOGLE_CLIENT_ID=<Google OAuth web client id>
GOOGLE_CLIENT_SECRET=<Google OAuth web client secret>
AUTH_DEV_PASSWORD_LOGIN=false
# Testing phase: Google emails that may sign in to the student app as parents of the test class (comma-separated).
SEED_TEST_PARENT_EMAILS=

# Media on Cloudflare R2
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
S3_REGION=auto
# Private bucket: every upload (drafts included). Public bucket: approved files only, behind the media domain.
S3_BUCKET=little-ants-files
S3_PUBLIC_BUCKET=little-ants-media
S3_ACCESS_KEY_ID=<R2 access key id>
S3_SECRET_ACCESS_KEY=<R2 secret access key>
MEDIA_PUBLIC_BASE_URL=https://media.littleantsenglish.com

# Only when running the tunnel in Docker (--profile tunnel) instead of cloudflared on the host.
CLOUDFLARE_TUNNEL_TOKEN=<tunnel token>

# Database backups to R2 (a separate bucket is recommended)
BACKUP_BUCKET=little-ants-backups
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR_UTC=19

# Curriculum import from Google Drive (docker compose --profile tools run --rm import)
GOOGLE_DRIVE_FOLDER_ID=1ZfucpQ9wQvn4ZpM6OARaKfnt-jbqC4Ko
# Folder shared by link: an API key restricted to the Drive API.
GOOGLE_DRIVE_API_KEY=<Google API key>
# Private folder: a service account the folder is shared with (wins over the API key).
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/repo/infra/secrets/drive-service-account.json
