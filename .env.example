# Copy to .env at the repository root and fill in real values. Never commit .env.

# PostgreSQL (docker compose dev service listens on 127.0.0.1:5433)
DATABASE_URL=postgresql://little_ants:little_ants@localhost:5433/little_ants

# API
API_PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Curriculum import from Google Drive (la-import --drive). The API key reads folders shared by link.
GOOGLE_DRIVE_FOLDER_ID=1ZfucpQ9wQvn4ZpM6OARaKfnt-jbqC4Ko
GOOGLE_DRIVE_API_KEY=
