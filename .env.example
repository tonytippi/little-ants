# Copy to .env at the repository root and fill in real values. Never commit .env.

# PostgreSQL (docker compose dev service listens on 127.0.0.1:5433)
DATABASE_URL=postgresql://little_ants:little_ants@localhost:5433/little_ants

# API
API_PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Invite emails, sent from a Gmail account. SMTP_PASSWORD is a Google app password (the account needs
# 2-Step Verification; create one at https://myaccount.google.com/apppasswords), not the account password.
# Leave both empty to save invites without sending email.
SMTP_USER=
SMTP_PASSWORD=
# MAIL_FROM_NAME=Little Ants English

# Curriculum import from Google Drive (la-import --drive). The API key reads folders shared by link.
GOOGLE_DRIVE_FOLDER_ID=1ZfucpQ9wQvn4ZpM6OARaKfnt-jbqC4Ko
GOOGLE_DRIVE_API_KEY=
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=./infra/secrets/drive-service-account.json
